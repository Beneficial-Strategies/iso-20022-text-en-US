// The en-US text host, https://iso-20022-text-en-us.beneficialstrategies.com: this repository's text laid over the ISO English of the hub
// (https://github.com/Beneficial-Strategies/iso-20022-text), served as static assets (no Worker code). Cloudflare Workers Builds watches this
// repository: the main branch deploys, other branches get preview addresses.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iso-20022-text-en-us",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site" },
  // DNS record and certificate are made on deploy; the name is one level below the zone (the free certificate covers *.beneficialstrategies.com)
  "routes": [{ "pattern": "iso-20022-text-en-us.beneficialstrategies.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // preview builds do not run the dashboard's build command, so the site is built here. The hub is fetched (HUB_REF, HUB_REPO choose another version);
  // the build tools and the ISO English are the hub's, this repository adds its glossary and exceptions
  "build": { "command": "rm -rf .hub && git clone --depth 1 --branch \"${HUB_REF:-main}\" \"${HUB_REPO:-https://github.com/Beneficial-Strategies/iso-20022-text}\" .hub && node .hub/build/build.mjs --spoke . --out site" },
  "previews": {}
}
